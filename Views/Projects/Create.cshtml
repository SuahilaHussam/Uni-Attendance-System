@{
    ViewData["Title"] = "Create Project";
}

<div class="page-heading">
    <div>
        <h2>Create New Project</h2>
        <p class="text-secondary">Add a new project to your workspace.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="content-card">
    <form>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Project Name</label>
                <input type="text" class="form-control" placeholder="Enter project name" required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Project Status</label>
                <select class="form-select" required>
                    <option value="">Select status</option>
                    <option>Planning</option>
                    <option>In Progress</option>
                    <option>Completed</option>
                    <option>On Hold</option>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label">Description</label>
                <textarea class="form-control" rows="4" placeholder="Describe your project"></textarea>
            </div>

            <div class="col-md-6">
                <label class="form-label">Start Date</label>
                <input type="date" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Deadline</label>
                <input type="date" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Team Members</label>
                <select class="form-select" multiple>
                    <option>Suhaila</option>
                    <option>Ahmed</option>
                    <option>Mohamed</option>
                    <option>Omar</option>
                </select>
                <small class="text-secondary">Hold Ctrl to select multiple members.</small>
            </div>

            <div class="col-md-6">
                <label class="form-label">Priority</label>
                <select class="form-select">
                    <option>Low</option>
                    <option selected>Medium</option>
                    <option>High</option>
                </select>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Create Project
            </button>
        </div>
    </form>
</div>