@{
    ViewData["Title"] = "Project Details";
}

<div class="page-heading">
    <div>
        <a asp-controller="Projects" asp-action="Index" class="text-secondary text-decoration-none">
            <i class="bi bi-arrow-left"></i> Back to Projects
        </a>
        <h2 class="mt-3">University Attendance System</h2>
        <p class="text-secondary">Project overview and information.</p>
    </div>

    <a asp-controller="Projects" asp-action="Edit" asp-route-id="1"
       class="btn btn-primary">
        <i class="bi bi-pencil"></i> Edit Project
    </a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="content-card mb-3">
            <h5>Project Overview</h5>
            <p class="text-secondary mt-3">
                A web-based University Student Attendance System that uses QR
                code technology to record and manage student attendance.
            </p>

            <div class="row mt-4">
                <div class="col-md-6 mb-3">
                    <small class="text-secondary">Project Status</small>
                    <p><span class="status-badge in-progress">In Progress</span></p>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-secondary">Project ID</small>
                    <p>#PR-001</p>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-secondary">Start Date</small>
                    <p>01 November 2026</p>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-secondary">Deadline</small>
                    <p>30 December 2026</p>
                </div>
            </div>
        </div>

        <div class="content-card">
            <h5>Project Progress</h5>
            <div class="d-flex justify-content-between mt-4 mb-2">
                <span class="text-secondary">Overall Completion</span>
                <strong>65%</strong>
            </div>
            <div class="progress">
                <div class="progress-bar" style="width:65%"></div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="content-card mb-3">
            <h5>Project Team</h5>
            <div class="d-flex align-items-center gap-3 mt-4">
                <div class="user-avatar">S</div>
                <div>
                    <strong>Suhaila</strong>
                    <small class="d-block text-secondary">Backend Developer</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3 mt-3">
                <div class="user-avatar">A</div>
                <div>
                    <strong>Ahmed</strong>
                    <small class="d-block text-secondary">AI Developer</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3 mt-3">
                <div class="user-avatar">M</div>
                <div>
                    <strong>Mohamed</strong>
                    <small class="d-block text-secondary">Flutter Developer</small>
                </div>
            </div>
        </div>

        <div class="content-card">
            <h5>Quick Actions</h5>
            <a asp-controller="Projects" asp-action="Kanban"
               class="btn btn-outline-primary w-100 mt-3">
                <i class="bi bi-kanban"></i> Open Kanban Board
            </a>
        </div>
    </div>
</div>