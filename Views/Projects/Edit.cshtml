
@{
    ViewData["Title"] = "Edit Project";
}

<div class="page-heading">
    <div>
        <h2>Edit Project</h2>
        <p class="text-secondary">Update your project information.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="content-card">
    <form>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Project Name</label>
                <input type="text" class="form-control"
                       value="University Attendance System" required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Project Status</label>
                <select class="form-select">
                    <option>Planning</option>
                    <option selected>In Progress</option>
                    <option>Completed</option>
                    <option>On Hold</option>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label">Description</label>
                <textarea class="form-control" rows="4">A system for managing university attendance and student records.</textarea>
            </div>

            <div class="col-md-6">
                <label class="form-label">Start Date</label>
                <input type="date" class="form-control" value="2026-10-01" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Deadline</label>
                <input type="date" class="form-control" value="2027-01-15" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Priority</label>
                <select class="form-select">
                    <option>Low</option>
                    <option selected>Medium</option>
                    <option>High</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Progress (%)</label>
                <input type="number" class="form-control"
                       min="0" max="100" value="65" />
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i> Save Changes
            </button>
        </div>
    </form>
</div>
